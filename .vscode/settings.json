{
  // Cargo package roots do not cover all of our cross-package #[path] modules. Adding this to remove error calls in rust-analyzer.
  "rust-analyzer.vfs.extraIncludes": [
    "${workspaceFolder}/tests",
    "${workspaceFolder}/platforms"
  ]
}
