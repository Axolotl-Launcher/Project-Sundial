# Track each leaked field and its readers without truncating the baseline key.

diff --git a/src/allow.rs b/src/allow.rs
index 1d9a076..d0474d5 100644
--- a/src/allow.rs
+++ b/src/allow.rs
@@ -87 +87 @@ impl AllowList {
-            .filter(|(lint, key)| !diagnostics.iter().any(|d| covers(*lint, key, d)))
+            .filter(|(lint, key)| !diagnostics.iter().any(|d| still_present(*lint, key, d)))
@@ -91,0 +92,7 @@ impl AllowList {
+fn still_present(lint: Lint, key: &str, diagnostic: &Diagnostic) -> bool {
+    if lint == Lint::FieldLeak && diagnostic.lint == lint {
+        return key.split(" @ ").next() == diagnostic.key.split(" @ ").next();
+    }
+    covers(lint, key, diagnostic)
+}
+
@@ -102,3 +109,23 @@ fn covers(lint: Lint, key: &str, diagnostic: &Diagnostic) -> bool {
-    let allowed = members(key);
-    matches!(lint, Lint::Tangle | Lint::ModuleCycle)
-        && members(&diagnostic.key)
+    match lint {
+        Lint::Tangle | Lint::ModuleCycle => {
+            let allowed = members(key);
+            members(&diagnostic.key)
+                .iter()
+                .all(|member| allowed.contains(member))
+        }
+        Lint::FieldLeak => covers_field_leak(key, &diagnostic.key),
+        _ => false,
+    }
+}
+
+/// An allowed field leak can shrink, but every remaining reader must be listed.
+fn covers_field_leak(allowed: &str, current: &str) -> bool {
+    let Some((allowed_field, allowed_readers)) = allowed.split_once(" @ ") else {
+        return false;
+    };
+    let Some((current_field, current_readers)) = current.split_once(" @ ") else {
+        return false;
+    };
+    let allowed_readers = members(allowed_readers);
+    allowed_field == current_field
+        && members(current_readers)
@@ -106 +133 @@ fn covers(lint: Lint, key: &str, diagnostic: &Diagnostic) -> bool {
-            .all(|member| allowed.contains(member))
+            .all(|reader| allowed_readers.contains(reader))
@@ -169,0 +197,16 @@ mod tests {
+    #[test]
+    fn an_allowed_field_leak_cannot_spread_to_new_readers() {
+        let allow = AllowList::parse("field-leak a::T::x @ a::b,a::c\n").unwrap();
+        let leak = |key| Diagnostic {
+            lint: Lint::FieldLeak,
+            ..tangle(key)
+        };
+        assert!(allow.is_allowed(&leak("a::T::x @ a::b,a::c")));
+        assert!(allow.is_allowed(&leak("a::T::x @ a::c")));
+        assert!(!allow.is_allowed(&leak("a::T::x @ a::b,a::c,a::d")));
+        assert!(!allow.is_allowed(&leak("a::T::x @ a::b,a::d")));
+        assert!(!allow.is_allowed(&leak("a::T::y @ a::b")));
+        assert_eq!(allow.fixed_count(&[leak("a::T::x @ a::b,a::c,a::d")]), 0);
+        assert_eq!(allow.fixed_count(&[leak("a::T::y @ a::b")]), 1);
+    }
+
