# Normalise line endings so Windows checkouts do not produce whitespace-only
# diffs. Keep binary assets and the lockfiles out of any text conversion.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Rust embeds its own hash in Cargo.lock; never let an EOL rewrite churn it.
Cargo.lock text eol=lf
pnpm-lock.yaml text eol=lf
